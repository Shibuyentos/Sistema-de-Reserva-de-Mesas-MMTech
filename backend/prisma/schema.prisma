// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  senha     String   @db.VarChar(255)
  perfil    String   @default("membro") @db.VarChar(20) // 'membro' ou 'admin'
  createdAt DateTime @default(now()) @map("created_at")

  reservas  Reserva[]

  @@map("usuarios")
}

model Mesa {
  id         Int      @id @default(autoincrement())
  capacidade Int
  status     String   @default("disponível") @db.VarChar(20)
  
  reservas   Reserva[]

  @@map("mesas")
}

model Reserva {
  id             Int       @id @default(autoincrement())
  mesaId         Int       @map("mesa_id")
  usuarioId      Int       @map("usuario_id") // FK para Usuario
  finalidade     String?   @db.VarChar(255)
  dataHoraInicio DateTime  @map("data_hora_inicio")
  dataHoraFim    DateTime  @map("data_hora_fim")
  checkInAt      DateTime? @map("check_in_at")
  checkOutAt     DateTime? @map("check_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relacionamentos
  mesa    Mesa    @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([mesaId])
  @@index([usuarioId])
  @@map("reservas")
}
